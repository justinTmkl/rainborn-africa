{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Kefalonia Summer",
  "description": "Mediterranean deck system for a Greek island travel presentation. Sun, sea, limestone, olive. Bright, high-key, cinematic.",
  "version": "1.0.0",
  "color": {
    "sea": {
      "abyss":   { "value": "#06384B", "comment": "Deepest Ionian. Text on light, backdrop for glass overlays." },
      "deep":    { "value": "#0B5673", "comment": "Primary brand blue. Chapter backgrounds." },
      "mid":     { "value": "#1187A8", "comment": "Mid-water. Links, active states, chart series 1." },
      "lagoon":  { "value": "#35B8C4", "comment": "Turquoise shallows. Primary accent." },
      "myrtos":  { "value": "#6FD9DC", "comment": "Myrtos beach water. Highlights, glows." },
      "foam":    { "value": "#C7EFEC", "comment": "Sea foam. Tinted surfaces, quiet fills." }
    },
    "stone": {
      "whitewash": { "value": "#FDFBF6", "comment": "Cycladic white. Default slide canvas." },
      "limestone": { "value": "#F4ECDD", "comment": "Warm second surface. Cards on white." },
      "sand":      { "value": "#E7D6B8", "comment": "Beach sand. Dividers, quiet borders." },
      "pebble":    { "value": "#CFC3AE", "comment": "Disabled, muted rules." }
    },
    "grove": {
      "olive":     { "value": "#7E8F4E", "comment": "Olive leaf. Ratings, secondary accent." },
      "oliveDeep": { "value": "#4E6039", "comment": "Olive shade. Text on sand." },
      "cypress":   { "value": "#29402F", "comment": "Cypress. Deep contrast on warm surfaces." }
    },
    "sun": {
      "core":       { "value": "#F6C049", "comment": "Midday sun. Primary warm accent, CTA." },
      "glow":       { "value": "#FFE29A", "comment": "Light shafts, hover glow, sun glint." },
      "apricot":    { "value": "#F2914C", "comment": "Late afternoon. Gradient midpoint." },
      "terracotta": { "value": "#C05A38", "comment": "Roof tiles. Warm structural accent." }
    },
    "bloom": {
      "bougainvillea": { "value": "#D8456E", "comment": "Flower pink. Single loud accent — use sparingly." },
      "mavrodaphne":   { "value": "#6E2438", "comment": "Wine red. Taverna / food chapter accent." }
    },
    "ink": {
      "strong": { "value": "#12303B", "comment": "Headlines on light." },
      "soft":   { "value": "#3E5A66", "comment": "Body copy on light." },
      "mute":   { "value": "#6E858F", "comment": "Captions, metadata." },
      "onDark": { "value": "#FDFBF6", "comment": "Anything on sea/photo backgrounds." }
    }
  },
  "gradient": {
    "aegean":   { "value": "linear-gradient(165deg, #0B5673 0%, #1187A8 45%, #35B8C4 100%)" },
    "shallows": { "value": "linear-gradient(180deg, #6FD9DC 0%, #35B8C4 40%, #1187A8 100%)" },
    "sunset":   { "value": "linear-gradient(100deg, #FFE29A 0%, #F6C049 28%, #F2914C 62%, #D8456E 100%)" },
    "sunrise":  { "value": "linear-gradient(180deg, #FFE29A 0%, #F4ECDD 55%, #C7EFEC 100%)" },
    "limestone":{ "value": "linear-gradient(160deg, #FDFBF6 0%, #F4ECDD 100%)" },
    "scrim":    { "value": "linear-gradient(0deg, rgba(6,56,75,0.88) 0%, rgba(6,56,75,0.45) 38%, rgba(6,56,75,0.05) 72%, rgba(6,56,75,0) 100%)", "comment": "Bottom-up scrim. Mandatory behind text on photos." },
    "sunGlint": { "value": "radial-gradient(circle at 72% 18%, rgba(255,226,154,0.55) 0%, rgba(255,226,154,0.12) 34%, rgba(255,226,154,0) 62%)" }
  },
  "typography": {
    "family": {
      "display": { "value": "'Cormorant Garamond', 'Playfair Display', Georgia, serif", "comment": "Headlines only. High contrast, Mediterranean." },
      "sans":    { "value": "'DM Sans', 'Inter', system-ui, sans-serif", "comment": "Body, UI, data." },
      "script":  { "value": "'Caveat', 'Segoe Script', cursive", "comment": "Travel-journal annotations. Max 1 per slide." },
      "mono":    { "value": "'IBM Plex Mono', ui-monospace, monospace", "comment": "Coordinates, times, sea temperature." }
    },
    "scale": {
      "comment": "Designed on a fixed 1920x1080 canvas. Values are px on that canvas; DeckShell scales the whole slide.",
      "displayXl": { "value": { "size": 152, "lineHeight": 0.92, "weight": 300, "tracking": "-0.02em", "family": "display" } },
      "displayL":  { "value": { "size": 108, "lineHeight": 0.96, "weight": 300, "tracking": "-0.015em", "family": "display" } },
      "displayM":  { "value": { "size": 74,  "lineHeight": 1.02, "weight": 400, "tracking": "-0.01em", "family": "display" } },
      "title":     { "value": { "size": 52,  "lineHeight": 1.12, "weight": 500, "tracking": "0", "family": "display" } },
      "subtitle":  { "value": { "size": 34,  "lineHeight": 1.32, "weight": 300, "tracking": "0", "family": "sans" } },
      "bodyL":     { "value": { "size": 26,  "lineHeight": 1.5,  "weight": 400, "tracking": "0", "family": "sans" } },
      "body":      { "value": { "size": 21,  "lineHeight": 1.55, "weight": 400, "tracking": "0", "family": "sans" } },
      "caption":   { "value": { "size": 17,  "lineHeight": 1.45, "weight": 400, "tracking": "0.01em", "family": "sans" } },
      "eyebrow":   { "value": { "size": 15,  "lineHeight": 1.2,  "weight": 500, "tracking": "0.22em", "family": "sans", "transform": "uppercase" } },
      "note":      { "value": { "size": 30,  "lineHeight": 1.2,  "weight": 400, "tracking": "0", "family": "script" } },
      "numeral":   { "value": { "size": 220, "lineHeight": 0.8,  "weight": 300, "tracking": "-0.04em", "family": "display" } }
    }
  },
  "space": {
    "1": { "value": 4 }, "2": { "value": 8 }, "3": { "value": 12 }, "4": { "value": 16 },
    "5": { "value": 24 }, "6": { "value": 32 }, "7": { "value": 48 }, "8": { "value": 64 },
    "9": { "value": 96 }, "10": { "value": 128 }, "11": { "value": 160 },
    "slideGutter": { "value": 128, "comment": "Safe margin on the 1920x1080 canvas." }
  },
  "radius": {
    "none": { "value": 0 },
    "sm":   { "value": 8 },
    "md":   { "value": 16 },
    "lg":   { "value": 24 },
    "xl":   { "value": 32 },
    "pill": { "value": 999 },
    "arch": { "value": "50% 50% 0 0 / 42% 42% 0 0", "comment": "Greek arch / church window. Signature shape for portrait media." }
  },
  "shadow": {
    "sm":  { "value": "0 2px 8px rgba(18,48,59,0.08)" },
    "md":  { "value": "0 12px 32px rgba(18,48,59,0.12)" },
    "lg":  { "value": "0 28px 64px rgba(18,48,59,0.18)" },
    "sun": { "value": "0 18px 48px rgba(246,192,73,0.30)" },
    "sea": { "value": "0 24px 56px rgba(11,86,115,0.28)" }
  },
  "border": {
    "hairline": { "value": "1px solid rgba(18,48,59,0.10)" },
    "sand":     { "value": "1px solid #E7D6B8" },
    "glass":    { "value": "1px solid rgba(253,251,246,0.28)" }
  },
  "blur": {
    "glass": { "value": "blur(18px) saturate(130%)", "comment": "Frosted overlay cards on photos/video." }
  },
  "motion": {
    "duration": {
      "quick":     { "value": "180ms" },
      "base":      { "value": "320ms" },
      "slow":      { "value": "640ms" },
      "cinematic": { "value": "1200ms" },
      "kenBurns":  { "value": "18000ms" },
      "shimmer":   { "value": "7000ms" }
    },
    "easing": {
      "swell": { "value": "cubic-bezier(0.22, 1, 0.36, 1)", "comment": "Default. Waves arriving on sand." },
      "tide":  { "value": "cubic-bezier(0.65, 0, 0.35, 1)", "comment": "Symmetric, for transforms both ways." },
      "lift":  { "value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "comment": "Slight overshoot. Pins, badges, chips." },
      "drift": { "value": "cubic-bezier(0.45, 0, 0.55, 1)", "comment": "Long ambient loops." }
    },
    "stagger": { "value": "90ms", "comment": "Delay between siblings revealing." }
  },
  "aspect": {
    "slide":    { "value": "16 / 9" },
    "photo":    { "value": "3 / 2" },
    "portrait": { "value": "4 / 5" },
    "arch":     { "value": "5 / 8" }
  }
}
